# Praxis CRM - configuracion local de docker compose
# Copiar a .env y ajustar. Los valores de aqui tienen prioridad
# sobre los defaults que estan escritos en docker-compose.yml.

# --- base de datos (primaria y espejo) ---
POSTGRES_DB=praxis_crm
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis_secret

# --- replicacion hacia el espejo ---
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_secret
REPLICATION_SLOT=praxis_mirror_slot
REWIND_USER=rewind_user
REWIND_PASSWORD=rewind_user_secret

# --- conmutacion de failover ---
# db       = primaria normal (default)
# db-mirror = espejo promovido a primaria
# El script docker/failover.sh modifica esta linea por ti.
DB_HOST=db

# --- puertos publicados en el host ---
DB_PUBLISHED_PORT=5432
MIRROR_PUBLISHED_PORT=5433
# Puerto del frontend. El contenedor escucha en 80; esto es el puerto
# del host, donde queda en http://localhost:5173
FR_PUBLISHED_PORT=5173

# --- backups automaticos con pg_dump ---
# Hora en UTC (el contenedor de backup trabaja en UTC).
BACKUP_AT=02:00
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
BACKUP_RUN_ON_START=true
