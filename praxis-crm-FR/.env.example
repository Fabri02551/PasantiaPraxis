# La API se llama con ruta RELATIVA (/api/...) y no con un host absoluto.
#
# Razón: la app se sirve por HTTPS (ver scripts/dev-certs.sh) porque la
# geolocalización del navegador solo funciona en contexto seguro. Pedir
# http://localhost:8080 desde una página https es contenido mixto y el
# navegador lo bloquea. Con la ruta relativa, la petición sale al mismo origen
# y el nginx hace de proxy hacia el backend.
#
# Solo completá esto si corrés el frontend con `npm run dev` en otra máquina o
# apuntando a una API remota; en docker ya alcanza con dejarlo vacío.
VITE_API_URL=

VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
