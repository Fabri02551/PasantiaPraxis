# Entorno para el build ANDROID (vite build --mode android).
# La app empaquetada no pasa por el nginx de proxy: llama a la API de
# producción con URL absoluta (CORS ya lo permite la API).
VITE_API_URL=https://crm.laboratoriopraxis.com
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
