# ============================================================
# Praxis CRM - variables de entorno
#
# ÚNICO archivo de entorno del repositorio: toda la configuración externa
# (Docker, API, ETL, frontend) vive acá.
#
# - Este archivo NO se commitea (ver .gitignore). Se crea con:
#       cp .env.example .env
# - docker compose lee solo este archivo: los valores de abajo son los que
#   llegan a los contenedores (ver las claves ${...} en docker-compose.yml).
# - Vite lo lee desde la raíz del repo (envDir en vite.config.ts), así que
#   `npm run dev` usa estos mismos valores.
#
# Los .env dentro de cada carpeta quedaron eliminados a propósito: tener el
# mismo dato en dos lados termina en que uno se queda viejo.
# ============================================================


# ------------------------------------------------------------
# Postgres
# ------------------------------------------------------------

# Host de la base. Dentro de compose es el nombre del servicio "db".
# Para correr la API o el ETL fuera de Docker, poné localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=praxis_crm
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis_secret

# Conexión que usan api y etl-init.
# OJO: es una cadena completa, no se arma sola desde las variables de arriba.
# Si cambiás POSTGRES_USER o POSTGRES_PASSWORD, actualizá esta línea también.
# Fuera de Docker el host va como localhost:
# DATABASE_URL=postgres://praxis:praxis_secret@localhost:5432/praxis_crm?sslmode=disable
DATABASE_URL=postgres://praxis:praxis_secret@db:5432/praxis_crm?sslmode=disable


# ------------------------------------------------------------
# API (Go)
# ------------------------------------------------------------

API_PORT=8080
APP_ENV=development

# En producción esto es un secreto de verdad: si cambia, cierra las sesiones
# abiertas (el JWT lleva su firma).
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------
# Email SMTP (Hostinger)
# ------------------------------------------------------------

# Con estos datos el ETL manda por correo las credenciales que crea y la
# API hace lo mismo con los usuarios que se dan de alta desde el panel
# (visitadores y administradores): cada uno recibe la suya y
# ETL_ADMIN_EMAIL recibe el resumen del ETL.
# Si SMTP_HOST queda vacío no se manda nada: el ETL deja las contraseñas
# en logs/visitadores_*.log y la API las devuelve una sola vez en la
# respuesta del alta.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=soporte@laboratoriopraxis.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM=soporte@laboratoriopraxis.com
SMTP_FROM_NAME="Laboratorio Praxis"
# ssl (465) | starttls (587) | plain
SMTP_ENCRYPTION=ssl


# ------------------------------------------------------------
# ETL
# ------------------------------------------------------------

# Raíz de los CSV dentro del contenedor del ETL.
ETL_SRC_DIR=/app/src

# Cada cuánto repite el ETL cuando se lo corre en loop (ETL_ONCE vacío).
# El servicio etl-init de compose lo corre una sola vez por base de datos.
ETL_EVERY=24h

# Cuenta administradora que siembra el ETL en cada corrida (rol admin en
# users) y casilla que recibe copia de las credenciales nuevas.
# Vacío = el ETL no crea admin ni manda copia.
ETL_ADMIN_EMAIL=nicolastocoyucra@gmail.com

# Enlace de ingreso que aparece en los correos de credenciales.
APP_URL=https://crm.laboratoriopraxis.com


# ------------------------------------------------------------
# Frontend (Vite) - todo lo que vaya al cliente necesita el prefijo VITE_
# ------------------------------------------------------------

# La API se llama con ruta RELATIVA (/api/...) y no con un host absoluto.
#
# Razón: la app se sirve por HTTPS porque la geolocalización del navegador solo
# funciona en contexto seguro. Pedir http://localhost:8080 desde una página
# https es contenido mixto y el navegador lo bloquea. Con la ruta relativa la
# petición sale al mismo origen y el nginx hace de proxy hacia el backend.
#
# Solo completá esto si corrés el frontend con `npm run dev` en otra máquina o
# apuntando a una API remota; en docker ya alcanza con dejarlo vacío.
VITE_API_URL=

VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png